{
  "name": "trending-hub",
  "version": "1.0.0",
  "description": "本地热点聚合 - B站热榜 / 微博热搜 / 抖音热榜",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
